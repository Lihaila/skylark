    "Copy a link (ss://, vmess://, vless://, trojan://, hy2://…) or a subscription URL from your provider, then tap Paste.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从服务商处复制节点链接（ss://、vmess://、vless://、trojan://、hy2:// 等）或订阅地址，然后点「从剪贴板粘贴」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從服務商複製節點連結（ss://、vmess://、vless://、trojan://、hy2:// 等）或訂閱網址，然後點「從剪貼簿貼上」"
          }
        }
      }
