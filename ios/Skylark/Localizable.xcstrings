    "Changes apply immediately while connected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中修改会立即生效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線中修改會立即生效"
          }
        }
      }
    },
    "Chinese sites and apps connect directly. Handy for WeChat, Bilibili and banking apps from abroad.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中国网站和应用直连，适合在海外使用微信、B站、银行等应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中國網站和應用程式直連，適合在海外使用微信、B站、銀行等應用程式"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
